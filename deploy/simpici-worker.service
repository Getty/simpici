[Unit]
Description=SimpiCI isolated outbound runner
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=simpici-worker
Group=simpici-worker
SupplementaryGroups=docker
UMask=0077
StateDirectory=simpici-worker
EnvironmentFile=/etc/simpici/worker.env
ExecStart=/usr/local/bin/simpici-worker --dispatcher ${SIMPICI_DISPATCHER} --root /var/lib/simpici-worker
Restart=on-failure
RestartSec=10
# The worker ends its run itself on TERM: executor, job containers, secret
# files. control-group lets what is left after a worker that died end the
# run in its place; mixed would only ever send that KILL. See
# deploy/README.md, "Stopping a worker, and a worker that is killed".
KillMode=control-group
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/simpici-worker

[Install]
WantedBy=multi-user.target
