#!/usr/bin/env bash
set -euo pipefail

readonly phases=(prepare build test package publish deploy)
workspace="${GITHUB_WORKSPACE:-${FORGEJO_WORKSPACE:-$PWD}}"
action_temp="${RUNNER_TEMP:-${TMPDIR:-/tmp}}/simpici-${GITHUB_RUN_ID:-${FORGEJO_RUN_ID:-$$}}"
event_host="$action_temp/event.json"
mkdir -p "$action_temp/outputs" "$action_temp/artifacts"

phase_rank() {
  case "$1" in
    prepare) printf '10' ;; build) printf '20' ;; test) printf '30' ;;
    "package") printf '40' ;; publish) printf '50' ;; deploy) printf '60' ;;
    *) return 1 ;;
  esac
}

resolve_image() {
  local expression="$1"
  case "$expression" in
    linux) printf 'docker.io/library/debian:latest'; return ;;
    perl) printf 'docker.io/library/perl:latest'; return ;;
    node) printf 'docker.io/library/node:latest'; return ;;
    python) printf 'docker.io/library/python:latest'; return ;;
  esac
  local -a parts
  IFS=+ read -r -a parts <<<"$expression"
  (( ${#parts[@]} >= 2 )) || {
    printf 'SimpiCI: image needs an alias or explicit tag: %s\n' "$expression" >&2
    return 64
  }
  local tag="${parts[-1]}"
  unset 'parts[-1]'
  local repository
  repository="$(IFS=/; printf '%s' "${parts[*]}")"
  if [[ "${parts[0]}" == *.* || "${parts[0]}" == *:* || "${parts[0]}" == localhost ]]; then
    printf '%s:%s' "$repository" "$tag"
  elif (( ${#parts[@]} == 1 )); then
    printf 'docker.io/library/%s:%s' "$repository" "$tag"
  else
    printf 'docker.io/%s:%s' "$repository" "$tag"
  fi
}

parse_script() {
  local script="$1" basename stem phase_job phase job expression image rank
  basename="${script##*/}"
  stem="${basename%.sh}"
  [[ "$stem" == *+* ]] || {
    printf 'SimpiCI: invalid top-level script name: %s\n' "$basename" >&2
    return 64
  }
  phase_job="${stem##*+}"
  phase="${phase_job%%.*}"
  phase_rank "$phase" >/dev/null || {
    printf 'SimpiCI: unknown phase in %s\n' "$basename" >&2
    return 64
  }
  expression="${stem%+"$phase_job"}"
  job="${phase_job#*.}"
  [[ "$job" == "$phase_job" ]] && job="$expression"
  image="$(resolve_image "$expression")"
  rank="$(phase_rank "$phase")"
  printf '%s\t%s\t%s\t%s\t%s\n' "$rank" "$phase" "$image" "$job" "$basename"
}

shopt -s nullglob
scripts=("$workspace/.cicd/"*.sh)
shopt -u nullglob
(( ${#scripts[@]} > 0 )) || {
  printf 'SimpiCI: no top-level .cicd/*.sh scripts found\n' >&2
  exit 127
}
plan="$action_temp/plan"
: >"$plan"
for script in "${scripts[@]}"; do parse_script "$script" >>"$plan"; done
sort -o "$plan" "$plan"
duplicates="$(cut -f2,4 "$plan" | sort | uniq -d)"
[[ -z "$duplicates" ]] || {
  printf 'SimpiCI: duplicate phase/job names:\n%s\n' "$duplicates" >&2
  exit 64
}
if [[ "${SIMPICI_PLAN_ONLY:-false}" == true ]]; then cat "$plan"; exit 0; fi

source_name=github-actions
[[ -n "${FORGEJO_ACTIONS:-}" || -n "${FORGEJO_SERVER_URL:-}" ]] && source_name=forgejo-actions
export CICD_RUN_NUMBER="${CICD_RUN_NUMBER:-${GITHUB_RUN_NUMBER:-${FORGEJO_RUN_NUMBER:-0}}}"
export CICD_SOURCE="${CICD_SOURCE:-$source_name}"
export CICD_EVENT="${CICD_EVENT:-${GITHUB_EVENT_NAME:-${FORGEJO_EVENT_NAME:-push}}}"
export CICD_REPOSITORY="${CICD_REPOSITORY:-${GITHUB_REPOSITORY:-${FORGEJO_REPOSITORY:-unknown}}}"
export CICD_CLONE_URL="${CICD_CLONE_URL:-${GITHUB_SERVER_URL:-${FORGEJO_SERVER_URL:-}}/${CICD_REPOSITORY}.git}"
export CICD_REF="${CICD_REF:-${GITHUB_REF:-${FORGEJO_REF:-}}}"
export CICD_COMMIT="${CICD_COMMIT:-${GITHUB_SHA:-${FORGEJO_SHA:-}}}"
export CICD_BRANCH='' CICD_TAG=''
[[ "$CICD_REF" == refs/heads/* ]] && CICD_BRANCH="${CICD_REF#refs/heads/}"
[[ "$CICD_REF" == refs/tags/* ]] && CICD_TAG="${CICD_REF#refs/tags/}"

json_string() {
  local value="$1"
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || return 65
  value="${value//\\/\\\\}"; value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}
umask 077
{
  printf '{\n'
  printf '  "source": %s,\n' "$(json_string "$CICD_SOURCE")"
  printf '  "event": %s,\n' "$(json_string "$CICD_EVENT")"
  printf '  "repository": %s,\n' "$(json_string "$CICD_REPOSITORY")"
  printf '  "clone_url": %s,\n' "$(json_string "$CICD_CLONE_URL")"
  printf '  "ref": %s,\n' "$(json_string "$CICD_REF")"
  printf '  "commit": %s\n' "$(json_string "$CICD_COMMIT")"
  printf '}\n'
} >"$event_host"

run_job() {
  local phase="$1" image="$2" job="$3" basename="$4"
  local output_host="$action_temp/outputs/$phase/$job"
  local artifacts_host="$action_temp/artifacts/$phase/$job"
  mkdir -p "$output_host" "$artifacts_host"
  local -a environment=(
    -e "CICD_RUN_NUMBER=$CICD_RUN_NUMBER" -e "CICD_SOURCE=$CICD_SOURCE"
    -e "CICD_EVENT=$CICD_EVENT" -e "CICD_REPOSITORY=$CICD_REPOSITORY"
    -e "CICD_CLONE_URL=$CICD_CLONE_URL" -e "CICD_REF=$CICD_REF"
    -e "CICD_BRANCH=$CICD_BRANCH" -e "CICD_TAG=$CICD_TAG"
    -e "CICD_COMMIT=$CICD_COMMIT" -e "CICD_PHASE=$phase" -e "CICD_JOB=$job"
    -e "CICD_IMAGE_REF=$image" -e "CICD_IMAGE_REPOSITORY=${CICD_IMAGE_REPOSITORY:-}"
    -e CICD_WORKSPACE=/workspace -e CICD_EVENT_FILE=/run/simpici/event.json
    -e CICD_ROOT=/workspace/.cicd -e CICD_OUTPUT=/output -e CICD_ARTIFACTS=/artifacts
  )
  if [[ "$phase" == publish || "$phase" == deploy ]]; then
    environment+=(
      -e "CICD_REGISTRY=${CICD_REGISTRY:-}" -e "CICD_REGISTRY_USER=${CICD_REGISTRY_USER:-}"
      -e "CICD_REGISTRY_PASSWORD=${CICD_REGISTRY_PASSWORD:-}"
      -e "CICD_PUBLISH_IMAGE=${CICD_PUBLISH_IMAGE:-false}"
    )
  fi
  local -a mounts=(
    -v "$workspace:/workspace:ro" -v "$event_host:/run/simpici/event.json:ro"
    -v "$output_host:/output" -v "$artifacts_host:/artifacts"
  )
  local docker_socket=/var/run/docker.sock
  if [[ "${DOCKER_HOST:-}" == unix://* ]]; then
    docker_socket="${DOCKER_HOST#unix://}"
  elif [[ ! -S "$docker_socket" ]]; then
    local context_socket
    context_socket="$(docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null || true)"
    [[ "$context_socket" == unix://* ]] && docker_socket="${context_socket#unix://}"
  fi
  if [[ "$phase" == build || "$phase" == publish ]] && [[ -S "$docker_socket" ]]; then
    mounts+=( -v "$docker_socket:/var/run/docker.sock" )
    environment+=( -e DOCKER_HOST=unix:///var/run/docker.sock )
  fi
  printf 'SimpiCI: %s/%s using %s\n' "$phase" "$job" "$image"
  docker run --rm --workdir /workspace "${mounts[@]}" "${environment[@]}" \
    "$image" "/workspace/.cicd/$basename" /run/simpici/event.json
}

for phase in "${phases[@]}"; do
  pids=()
  while IFS=$'\t' read -r rank planned_phase image job basename; do
    [[ "$planned_phase" == "$phase" ]] || continue
    run_job "$phase" "$image" "$job" "$basename" & pids+=("$!")
  done <"$plan"
  failed=0
  for pid in "${pids[@]}"; do
    if wait "$pid"; then :; else status=$?; [[ $status -eq 78 ]] || failed=1; fi
  done
  (( failed == 0 )) || {
    printf 'SimpiCI: phase %s failed; later phases will not start\n' "$phase" >&2
    exit 1
  }
done
