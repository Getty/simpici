#!/usr/bin/env bash
set -euo pipefail
umask 077

readonly phases=(prepare build test package publish deploy)
workspace="${CICD_WORKSPACE:-${GITHUB_WORKSPACE:-${FORGEJO_WORKSPACE:-$PWD}}}"
action_temp="$(mktemp -d "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/simpici.XXXXXXXX")"
event_host="$action_temp/event.json"
mkdir -p "$action_temp/outputs" "$action_temp/artifacts"
cleanup_containers() {
  local cidfile
  for cidfile in "$action_temp"/*.cid; do
    [[ -f "$cidfile" ]] || continue
    docker rm -f "$(cat "$cidfile")" >/dev/null 2>&1 || true
  done
}
trap cleanup_containers EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

phase_rank() {
  case "$1" in
    prepare) printf '10' ;; build) printf '20' ;; test) printf '30' ;;
    "package") printf '40' ;; publish) printf '50' ;; deploy) printf '60' ;;
    *) return 1 ;;
  esac
}

resolve_image() {
  local expression="$1"
  case "$expression" in
    linux) printf 'docker.io/library/debian:latest'; return ;;
    perl) printf 'docker.io/library/perl:latest'; return ;;
    node) printf 'docker.io/library/node:latest'; return ;;
    python) printf 'docker.io/library/python:latest'; return ;;
  esac
  local -a parts
  IFS=+ read -r -a parts <<<"$expression"
  (( ${#parts[@]} >= 2 )) || {
    printf 'SimpiCI: image needs an alias or explicit tag: %s\n' "$expression" >&2
    return 64
  }
  local tag="${parts[-1]}"
  unset 'parts[-1]'
  local repository
  repository="$(IFS=/; printf '%s' "${parts[*]}")"
  if [[ "${parts[0]}" == *.* || "${parts[0]}" == *:* || "${parts[0]}" == localhost ]]; then
    printf '%s:%s' "$repository" "$tag"
  elif (( ${#parts[@]} == 1 )); then
    printf 'docker.io/library/%s:%s' "$repository" "$tag"
  else
    printf 'docker.io/%s:%s' "$repository" "$tag"
  fi
}

parse_script() {
  local script="$1" basename stem phase_job phase job expression image rank
  basename="${script##*/}"
  [[ ! -L "$script" && "$basename" =~ ^[a-zA-Z0-9_][a-zA-Z0-9_.+-]*\.sh$ && "$basename" != *..* ]] || {
    printf 'SimpiCI: unsafe script name: %s\n' "$basename" >&2
    return 64
  }
  stem="${basename%.sh}"
  [[ "$stem" == *+* ]] || {
    printf 'SimpiCI: invalid top-level script name: %s\n' "$basename" >&2
    return 64
  }
  phase_job="${stem##*+}"
  phase="${phase_job%%.*}"
  phase_rank "$phase" >/dev/null || {
    printf 'SimpiCI: unknown phase in %s\n' "$basename" >&2
    return 64
  }
  expression="${stem%+"$phase_job"}"
  job="${phase_job#*.}"
  [[ "$job" == "$phase_job" ]] && job="$expression"
  image="$(resolve_image "$expression")"
  rank="$(phase_rank "$phase")"
  printf '%s\t%s\t%s\t%s\t%s\n' "$rank" "$phase" "$image" "$job" "$basename"
}

source_name=github-actions
[[ -n "${FORGEJO_ACTIONS:-}" || -n "${FORGEJO_SERVER_URL:-}" ]] && source_name=forgejo-actions
export CICD_RUN_NUMBER="${CICD_RUN_NUMBER:-${GITHUB_RUN_NUMBER:-${FORGEJO_RUN_NUMBER:-0}}}"
export CICD_SOURCE="${CICD_SOURCE:-$source_name}"
export CICD_EVENT="${CICD_EVENT:-${GITHUB_EVENT_NAME:-${FORGEJO_EVENT_NAME:-push}}}"
export CICD_REPOSITORY="${CICD_REPOSITORY:-${GITHUB_REPOSITORY:-${FORGEJO_REPOSITORY:-unknown}}}"
export CICD_CLONE_URL="${CICD_CLONE_URL:-${GITHUB_SERVER_URL:-${FORGEJO_SERVER_URL:-}}/${CICD_REPOSITORY}.git}"
export CICD_REF="${CICD_REF:-${GITHUB_REF:-${FORGEJO_REF:-}}}"
export CICD_COMMIT="${CICD_COMMIT:-${GITHUB_SHA:-${FORGEJO_SHA:-}}}"
export CICD_BRANCH='' CICD_TAG=''
[[ "$CICD_REF" == refs/heads/* ]] && CICD_BRANCH="${CICD_REF#refs/heads/}"
[[ "$CICD_REF" == refs/tags/* ]] && CICD_TAG="${CICD_REF#refs/tags/}"

json_string() {
  local value="$1"
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || return 65
  value="${value//\\/\\\\}"; value="${value//\"/\\\"}"
  printf '"%s"' "$value"
}
umask 077
{
  printf '{\n'
  printf '  "source": %s,\n' "$(json_string "$CICD_SOURCE")"
  printf '  "event": %s,\n' "$(json_string "$CICD_EVENT")"
  printf '  "repository": %s,\n' "$(json_string "$CICD_REPOSITORY")"
  printf '  "clone_url": %s,\n' "$(json_string "$CICD_CLONE_URL")"
  printf '  "ref": %s,\n' "$(json_string "$CICD_REF")"
  printf '  "commit": %s\n' "$(json_string "$CICD_COMMIT")"
  printf '}\n'
} >"$event_host"

# Build the effective .cicd in a writable staging directory: the repository's
# own top-level jobs first, then whatever providers contribute. The checkout
# stays read-only, and a repository need not ship a .cicd at all when a provider
# supplies its jobs.
staging="$action_temp/cicd"
mkdir -p "$staging"
if [[ -d "$workspace/.cicd" ]]; then
  cp -rp "$workspace/.cicd/." "$staging/"
fi

# Providers are pinned, org-owned images that generate additional .sh job files.
# Each runs once with the checkout read-only and its own private writable output
# directory; it never receives registry credentials or the Docker socket. Output
# is merged into staging WITHOUT overwriting existing names, so the repository's
# own jobs -- and then earlier providers -- always win a name collision.
providers=()
[[ -n "${SIMPICI_PROVIDERS:-}" ]] && read -r -a providers <<<"$SIMPICI_PROVIDERS"
provider_index=0
for provider_image in "${providers[@]}"; do
  [[ -n "$provider_image" ]] || continue
  provider_out="$action_temp/provider.$provider_index"
  mkdir -p "$provider_out"
  printf 'SimpiCI: provider %s\n' "$provider_image" >&2
  docker run --rm --cidfile "$action_temp/provider.$provider_index.cid" \
    --workdir /workspace \
    -v "$workspace:/workspace:ro" -v "$event_host:/run/simpici/event.json:ro" \
    -v "$provider_out:/cicd-out" \
    -e CICD_PROVIDER_OUT=/cicd-out \
    -e CICD_WORKSPACE=/workspace -e CICD_EVENT_FILE=/run/simpici/event.json \
    -e "CICD_SOURCE=$CICD_SOURCE" -e "CICD_EVENT=$CICD_EVENT" \
    -e "CICD_REPOSITORY=$CICD_REPOSITORY" -e "CICD_REF=$CICD_REF" \
    -e "CICD_BRANCH=$CICD_BRANCH" -e "CICD_TAG=$CICD_TAG" \
    -e "CICD_COMMIT=$CICD_COMMIT" \
    "$provider_image" /run/simpici/event.json
  cp -rpn "$provider_out/." "$staging/"
  provider_index=$((provider_index + 1))
done

shopt -s nullglob
scripts=("$staging/"*.sh)
shopt -u nullglob
(( ${#scripts[@]} > 0 )) || {
  printf 'SimpiCI: no .cicd/*.sh jobs from the checkout or any provider\n' >&2
  exit 127
}
plan="$action_temp/plan"
: >"$plan"
for script in "${scripts[@]}"; do parse_script "$script" >>"$plan"; done
sort -o "$plan" "$plan"
duplicates="$(cut -f2,4 "$plan" | sort | uniq -d)"
[[ -z "$duplicates" ]] || {
  printf 'SimpiCI: duplicate phase/job names:\n%s\n' "$duplicates" >&2
  exit 64
}
if [[ "${SIMPICI_PLAN_ONLY:-false}" == true ]]; then cat "$plan"; exit 0; fi

run_job() {
  local phase="$1" image="$2" job="$3" basename="$4"
  local output_host="$action_temp/outputs/$phase/$job"
  local artifacts_host="$action_temp/artifacts/$phase/$job"
  mkdir -p "$output_host" "$artifacts_host"
  local -a environment=(
    -e "CICD_RUN_NUMBER=$CICD_RUN_NUMBER" -e "CICD_SOURCE=$CICD_SOURCE"
    -e "CICD_EVENT=$CICD_EVENT" -e "CICD_REPOSITORY=$CICD_REPOSITORY"
    -e "CICD_CLONE_URL=$CICD_CLONE_URL" -e "CICD_REF=$CICD_REF"
    -e "CICD_BRANCH=$CICD_BRANCH" -e "CICD_TAG=$CICD_TAG"
    -e "CICD_COMMIT=$CICD_COMMIT" -e "CICD_PHASE=$phase" -e "CICD_JOB=$job"
    -e "CICD_IMAGE_REF=$image" -e "CICD_IMAGE_REPOSITORY=${CICD_IMAGE_REPOSITORY:-}"
    -e CICD_WORKSPACE=/workspace -e CICD_EVENT_FILE=/run/simpici/event.json
    -e CICD_ROOT=/cicd -e CICD_OUTPUT=/output -e CICD_ARTIFACTS=/artifacts
  )
  if [[ "$phase" == publish || "$phase" == deploy ]]; then
    environment+=(
      -e "CICD_REGISTRY=${CICD_REGISTRY:-}" -e "CICD_REGISTRY_USER=${CICD_REGISTRY_USER:-}"
      -e CICD_REGISTRY_PASSWORD
      -e "CICD_PUBLISH_IMAGE=${CICD_PUBLISH_IMAGE:-false}"
    )
    if [[ -n "${SIMPICI_SECRETS_DIR:-}" && -f "$SIMPICI_SECRETS_DIR/$phase.env" ]]; then
      environment+=( --env-file "$SIMPICI_SECRETS_DIR/$phase.env" )
    fi
  fi
  local -a mounts=(
    -v "$workspace:/workspace:ro" -v "$staging:/cicd:ro"
    -v "$event_host:/run/simpici/event.json:ro"
    -v "$output_host:/output" -v "$artifacts_host:/artifacts"
  )
  local docker_socket=/var/run/docker.sock
  if [[ "${DOCKER_HOST:-}" == unix://* ]]; then
    docker_socket="${DOCKER_HOST#unix://}"
  elif [[ ! -S "$docker_socket" ]]; then
    local context_socket
    context_socket="$(docker context inspect --format '{{.Endpoints.docker.Host}}' 2>/dev/null || true)"
    [[ "$context_socket" == unix://* ]] && docker_socket="${context_socket#unix://}"
  fi
  if [[ "$phase" == build || "$phase" == publish ]] && [[ -S "$docker_socket" ]]; then
    mounts+=( -v "$docker_socket:/var/run/docker.sock" )
    environment+=( -e DOCKER_HOST=unix:///var/run/docker.sock )
  fi
  printf 'SimpiCI: %s/%s using %s\n' "$phase" "$job" "$image" >&2
  # Jobs in a phase run concurrently, so their output would interleave into one
  # unreadable stream. Keep it fully live, but tag every line with the job it
  # came from, so the parallel output stays greppable (docker-compose style).
  local rc=0
  docker run --rm --cidfile "$action_temp/$phase.$job.cid" --workdir /workspace "${mounts[@]}" "${environment[@]}" \
    "$image" "/cicd/$basename" /run/simpici/event.json 2>&1 \
    | while IFS= read -r line; do printf '[%s/%s] %s\n' "$phase" "$job" "$line"; done || rc=$?
  printf '%s\n' "$rc" >"$action_temp/rc.$phase.$job"
  return "$rc"
}

# A per-job result table on the Actions run summary page, when one is available.
# This is a pure addition -- the live, tagged job output above is unchanged.
summary="${GITHUB_STEP_SUMMARY:-}"
[[ -n "$summary" ]] && printf '## SimpiCI\n\n| phase | job | image | result |\n|---|---|---|---|\n' >>"$summary"

for phase in "${phases[@]}"; do
  metas=()
  while IFS=$'\t' read -r rank planned_phase image job basename; do
    [[ "$planned_phase" == "$phase" ]] || continue
    metas+=("$image"$'\t'"$job"$'\t'"$basename")
  done <"$plan"
  (( ${#metas[@]} > 0 )) || continue

  pids=()
  for meta in "${metas[@]}"; do
    IFS=$'\t' read -r image job basename <<<"$meta"
    run_job "$phase" "$image" "$job" "$basename" & pids+=("$!")
  done
  for pid in "${pids[@]}"; do wait "$pid" || true; done

  failed=0
  for meta in "${metas[@]}"; do
    IFS=$'\t' read -r image job basename <<<"$meta"
    job_rc="$(cat "$action_temp/rc.$phase.$job" 2>/dev/null || echo 1)"
    case "$job_rc" in
      0)  result=ok ;;
      78) result=skipped ;;
      *)  result="FAILED (exit $job_rc)"; failed=1 ;;
    esac
    printf 'SimpiCI: %s/%s -> %s\n' "$phase" "$job" "$result" >&2
    [[ -n "$summary" ]] && printf '| %s | %s | `%s` | %s |\n' "$phase" "$job" "$image" "$result" >>"$summary"
  done

  (( failed == 0 )) || {
    printf 'SimpiCI: phase %s failed; later phases will not start\n' "$phase" >&2
    exit 1
  }
done
